# Database (optional — app runs on JSON seed fallback when unset)
DATABASE_URL=postgresql://user:password@host:5432/spnews
# Admin login (first-run: generate hash, see README)
ADMIN_EMAIL=admin@spnews.com.bd
ADMIN_PASSWORD_HASH=
# Vercel Blob (optional — uploads fall back to public/uploads when unset)
BLOB_READ_WRITE_TOKEN=
# Session secret for admin cookie signing (change in production)
SESSION_SECRET=change-me-to-a-long-random-string
NEXTAUTH_SECRET=change-me-to-a-long-random-string
